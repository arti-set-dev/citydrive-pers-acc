{
  "compilerOptions": {
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react-jsx",
    "target": "ESNext",
    "strict": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@citydrive/shared": ["packages/shared/src/index.ts"],
      "@citydrive/shared/*": ["packages/shared/src/*"],
      "@citydrive/entities": ["packages/entities/src/index.ts"],
      "@citydrive/entities/*": ["packages/entities/src/*"],
      "@citydrive/auth": ["packages/auth/src/index.ts"],
      "@citydrive/auth/*": ["packages/auth/src/*"]
    }
  },
  "include": [
    "webpack.config.ts",
    "webpack.auth.config.ts",
    "config",
    "json-server",
    "src",
    "packages",
    "apps",
    "eslint.config.ts",
    "cypress.config.ts",
    "lostpixel.config.ts",
    "stylelint.config.mjs",
    "config/.storybook/**/*.ts",
    "scripts/dirname.ts",
    "config/.storybook/preview.tsx"
  ]
}
